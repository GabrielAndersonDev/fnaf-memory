* {
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0);
	border-color: rgba(0, 0, 0, 0);
}

#cam-name-box {
	max-height: 6%;
	justify-content: space-between;
	flex-wrap: wrap;
	align-content: center;
}

#cam-name-box TextElement {
	width: 50%;
}

#cam-name {
	-unity-text-align: middle-left;
}

#power-text {
	-unity-text-align: middle-right;
}

#main {
	width: 100%;
	height: 100%;
	align-items: flex-end;
	justify-content: flex-end;
	
}

#cam-layout-sprite,
#flip-sprite-container,
#flip-sprite {
	position: absolute;
	opacity: 0;
}

#cams {
	width: 45%;
	height: 45%;
}

#cam-container {
	align-content: center;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
}

#cams Button {
	display: flex;
	flex: 20%;
	max-height: 20%;
	border-color: rgba(0, 0, 0, 1);
}