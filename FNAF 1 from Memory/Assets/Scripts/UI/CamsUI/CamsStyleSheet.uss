* {
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0);
	border-color: rgba(0, 0, 0, 0);
}

#cam-name-box {
	max-height: 6%;
	justify-content: space-between;
	flex-wrap: wrap;
	align-content: center;
}

#cam-name-box TextElement {
	width: 50%;
}

#cam-name {
	-unity-text-align: middle-left;
}

#power-text {
	-unity-text-align: middle-right;
}

#main {
	width: 100%;
	height: 100%;
	align-items: flex-end;
	justify-content: flex-end;
	
}

#cam-sprite, #cam-sprite-container, #cam-sprite-container Image {
	position: absolute;
}

#cams {
	width: 50%;
	height: 50%;
}

#cam-nav-sprite {
	align-content: center;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
}

#cams Button {
	color: rgba(93, 255, 205, 1);
	border-color: rgba(93, 255, 205, 1);
	position: relative;
	width: 13.125%;
	height: 15.833%;
}

